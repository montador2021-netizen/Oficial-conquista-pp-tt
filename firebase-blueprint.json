{
  "entities": {
    "Opportunity": {
      "title": "Opportunity",
      "description": "An opportunity in the CRM",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "stage": { "type": "string" },
        "vendedorId": { "type": "string" },
        "branchId": { "type": "string" }
      },
      "required": ["id", "title", "stage"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A sale in the system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numeroPedido": { "type": "string" },
        "total": { "type": "number" },
        "vendedorId": { "type": "string" },
        "branchId": { "type": "string" }
      },
      "required": ["id", "numeroPedido", "total"]
    },
    "UserPermission": {
      "title": "UserPermission",
      "description": "User role and branch assignment",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["supervisor", "manager", "vendor"] },
        "branchId": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "opportunities/{opportunityId}": {
      "schema": "Opportunity",
      "description": "CRM opportunities"
    },
    "vendas/{vendaId}": {
      "schema": "Sale",
      "description": "Sales records"
    },
    "permissions/{email}": {
      "schema": "UserPermission",
      "description": "User permission mappings"
    }
  }
}
