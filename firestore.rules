rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(data) { return isSignedIn() && request.auth.uid == data.vendedorId; }

    // Default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /opportunities/{opportunityId} {
      allow list: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.vendedorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.vendedorId == request.auth.uid && request.resource.data.vendedorId == resource.data.vendedorId;
      allow delete: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
    }

    match /vendas/{vendaId} {
      allow list: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.vendedorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.vendedorId == request.auth.uid && request.resource.data.vendedorId == resource.data.vendedorId;
      allow delete: if isSignedIn() && resource.data.vendedorId == request.auth.uid;
    }
  }
}
